# Optional bootstrap defaults.
# On first run these values seed the SQLite settings table.
# After that, edit values from the dashboard Settings page.
STOAT_BOT_TOKEN=your_stoat_bot_token
STOAT_MODERATION_CHANNEL_ID=channel_id_for_flag_logs
PUTER_AUTH_TOKEN=your_puter_auth_token

# Open-source default; change if you prefer another Puter-supported OSS model.
PUTER_MODEL=meta-llama/llama-3.1-8b-instruct
PUTER_TEMPERATURE=0.1

AUTO_MODERATION=false
ALLOWED_ACTIONS=warn,delete,timeout,kick,ban
MAX_AUTO_ACTION=delete
DEFAULT_TIMEOUT_MINUTES=30

DASHBOARD_PORT=3000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

SQLITE_PATH=./data/moderation.db
RECENT_CONTEXT_MESSAGES=12
